# ── Base de données (PostgreSQL) ───────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:6543/doni?pgbouncer=true"   # runtime (pooler)
DIRECT_URL="postgresql://user:password@host:5432/doni"                    # migrations

# ── Sécurité (obligatoires en production, ≥ 32 caractères aléatoires) ──────
AUTH_SECRET=
AUTH_MFA_ENCRYPTION_KEY=
AUTH_SESSION_FINGERPRINT_KEY=
SETTINGS_ENCRYPTION_KEY=          # chiffre les secrets d’intégration stockés en base
TICKET_LINK_SECRET=               # signe les liens de billets envoyés aux clients
CRON_SECRET=                      # Vercel Cron → Authorization: Bearer

# ── Passkeys / WebAuthn ────────────────────────────────────────────────────
AUTH_WEBAUTHN_RP_ID=doni-platform.vercel.app
AUTH_WEBAUTHN_ORIGIN=https://doni-platform.vercel.app

# ── Application ────────────────────────────────────────────────────────────
APP_URL=https://doni-platform.vercel.app
PUBLIC_APP_URL=https://doni-platform.vercel.app

# ── Développement uniquement — jamais en production ────────────────────────
# DONI_DEV_SIMULATOR=true                 # active POST /api/dev/conversation et /api/dev/flight-search
# PAYPAL_ALLOW_UNVERIFIED_WEBHOOKS=true   # désactive la vérification de signature PayPal (tests locaux)

# Les intégrations (WhatsApp/Meta, Duffel, Stripe, Mercado Pago, PayPal, Bazik, FlightAware,
# OAG, Anthropic OCR, Brevo) se configurent dans Réglages → Intégrations (chiffrées en base),
# pas ici.
